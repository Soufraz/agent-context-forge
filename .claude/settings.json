{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ENABLE_LSP_TOOL": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/agent-gates/check-lsp.sh\"",
            "statusMessage": "Checking Language Server Protocol (LSP) readiness..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit-prefix-stability.sh\"",
            "timeout": 60,
            "statusMessage": "Validating context prefix stability before commit..."
          }
        ]
      }
    ]
  }
}
